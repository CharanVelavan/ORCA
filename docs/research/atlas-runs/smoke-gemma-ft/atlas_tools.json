            }
          },
          "params": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "description": "One short sentence: why you make this call."
          }
        },
        "required": [
          "playbook",
          "targets",
          "reason",
          "rationale"
        ]
      }
    }
  },
