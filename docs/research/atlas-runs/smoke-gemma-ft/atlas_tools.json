[
  {
    "type": "function",
    "function": {
      "name": "read_alerts",
      "description": "Read the events, model alerts and messages released to YOU. source=M3 gives the fault-or-attack classification, source=M1 anomalies, M2 forecasts, M4 capacity; source=any gives everything. Use site only to narrow to one tower.",
      "parameters": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "any",
              "M1",
              "M2",
              "M3",
              "M4",
              "scenario"
            ]
          },
          "site": {
            "type": "string",
            "enum": [
              "any",
              "CHN-01",
              "CHN-02",
              "CHN-03",
              "CHN-04",
              "CHN-05",
              "CHN-06"
            ]
          },
          "rationale": {
            "type": "string",
            "description": "One short sentence: why you make this call."
          }
        },
        "required": [
          "rationale"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "explain_model",
