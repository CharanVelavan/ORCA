  {
    "type": "function",
    "function": {
      "name": "send_message",
      "description": "Send a typed protocol message to other agents or the commander. Types: inform, request, propose (name a playbook), object (reply to a message id). refs = evidence ids (alerts, records, gaps, plans).",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "inform",
              "request",
              "propose",
              "object"
            ]
          },
          "text": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_class": {
            "type": "string",
            "enum": [
              "operational",
              "technical_indicator",
              "legal_direction"
            ]
          },
          "playbook": {
            "type": "string"
          },
          "in_reply_to": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "description": "One short sentence: why you make this call."
          }
        },
        "required": [
          "to",
          "type",
          "text",
          "rationale"
        ]
      }
    }
  },
  {
