# LLM: Qwen3.8-27B on Google Cloud (OpenAI-compatible endpoint).
# Leave LLM_BASE_URL empty to use the local Ollama fallback (repo default).
LLM_BASE_URL=
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
# Local fallback
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text
# Reproducibility
LLM_TEMPERATURE=0
SEED=42
COUNTRY_KB=india
# Commander PIN: store only the sha256 hex of the PIN (printf PIN | shasum -a 256). Load with: set -a; . ./.env; set +a
ORCA_COMMANDER_PIN_SHA256=
