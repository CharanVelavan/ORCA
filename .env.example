# Optional endpoint configuration; this file contains no credentials.
# Recommended setup: follow docs/JUDGE_REPRODUCIBILITY.md or run quickstart.sh.
# Native Python does not load .env automatically. Export chosen values explicitly.
# Docker Compose reads .env for interpolation; blank values retain its mock defaults.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0

# Live example for the managed local fine-tuned Qwen server:
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=orca-ntn-qwen-ft
# LLM_MODE=live
# Use the model name returned by your server's /v1/models endpoint.
# Inside Docker, use host.docker.internal instead of 127.0.0.1 for a host server.
# There is no automatic Ollama fallback. Choose mock or live mode explicitly.

# Optional broad RAG: the published v2 index requires matching Qwen3 embeddings.
# The setup helper serves embeddings on 1235; standalone runtime defaults to 1234.
# ORCA_EMBED_URL=http://127.0.0.1:1235/v1
# ORCA_EMBED_MODEL=text-embedding-qwen3-embedding-8b
# ORCA_EMBED_KEY=
# ORCA_KBVEC_COLLECTION=orca_v2
